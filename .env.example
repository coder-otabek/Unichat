# ════════════════════════════════════════════════════════════
#  UniChat — .env (asosiy infra sozlamalari)
#  AI sozlamalari → Django Admin → Sayt sozlamalari
# ════════════════════════════════════════════════════════════

# ── Django ───────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ─────────────────────────────────────────────────
USE_SQLITE=True
DATABASE_URL=postgresql://unichat:password@localhost:5432/unichat_db

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8000
CORS_ALLOW_ALL_ORIGINS_IN_DEBUG=True

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_DAYS=7
JWT_REFRESH_LIFETIME_DAYS=30

# ── Qolgan (fallback uchun — admindan boshqariladi) ──────────
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
USE_LOCAL_EMBEDDINGS=True
